
@startuml
left to right direction

skinparam packageStyle rectangle
skinparam shadowing false

title Інтернет-магазин одягу та аксесуарів - Діаграма варіантів використання

actor Guest
actor Customer
actor Administrator

Customer --|> Guest

rectangle "Clothing and Accessories Online Store" {

    usecase "Browse Catalog" as UC1
    usecase "Search Product" as UC2
    usecase "Register Account" as UC3

    usecase "Add Product to Cart" as UC4
    usecase "Place Order" as UC5
    usecase "View Order History" as UC6

    usecase "Manage Products" as UC7
    usecase "Manage Orders" as UC8
    usecase "View Sales Reports" as UC9

    usecase "Check Variant Stock" as UC10
    usecase "Select Payment Method" as UC11
    usecase "Apply Discount" as UC12

    usecase "Search by Name" as UC13
    usecase "Search by Category" as UC14

    usecase "Select Size and Color" as UC15
    usecase "Manage Product Variants" as UC16
    usecase "Select Delivery Method" as UC17
}

Guest -- UC1
Guest -- UC2
Guest -- UC3

Customer -- UC4
Customer -- UC5
Customer -- UC6

Administrator -- UC7
Administrator -- UC8
Administrator -- UC9
Administrator -- UC16

' Пошук за назвою і категорією
UC13 --|> UC2
UC14 --|> UC2

' Додавання до кошика
UC4 ..> UC15 : <<include>>
UC4 ..> UC10 : <<include>>

' Оформлення замовлення
UC5 ..> UC10 : <<include>>
UC5 ..> UC11 : <<include>>
UC5 ..> UC17 : <<include>>

' Знижка як необов'язкове розширення
UC12 ..> UC5 : <<extend>>

@enduml
