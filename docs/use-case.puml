
@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

title Clothing & Accessories Store - Use Case Diagram

actor Guest
actor Customer
actor Administrator

Customer --|> Guest

rectangle "Clothing & Accessories Online Store" {

  usecase "Browse Catalog" as UC1
  usecase "Search Product" as UC2
  usecase "Register Account" as UC3
  usecase "Filter Products" as UC4

  usecase "Select Product Variant" as UC5
  usecase "Add Product to Cart" as UC6
  usecase "Place Order" as UC7
  usecase "View Order History" as UC8

  usecase "Manage Products" as UC9
  usecase "Manage Orders" as UC10
  usecase "View Sales Reports" as UC11
  usecase "Manage Product Variants" as UC12

  usecase "Check Variant Stock" as UC13
  usecase "Select Payment Method" as UC14
  usecase "Select Delivery Method" as UC15

  usecase "Apply Discount" as UC16

  usecase "Search by Name" as UC17
  usecase "Search by Category" as UC18
}

Guest -- UC1
Guest -- UC2
Guest -- UC3
Guest -- UC4

Customer -- UC5
Customer -- UC6
Customer -- UC7
Customer -- UC8

Administrator -- UC9
Administrator -- UC10
Administrator -- UC11
Administrator -- UC12

UC6 ..> UC5 : <<include>>
UC6 ..> UC13 : <<include>>

UC7 ..> UC13 : <<include>>
UC7 ..> UC14 : <<include>>
UC7 ..> UC15 : <<include>>

UC16 ..> UC7 : <<extend>>

UC17 --|> UC2
UC18 --|> UC2

@enduml
